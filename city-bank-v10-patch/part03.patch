+func _city_government_analysis() -> String:
+    var factors: Array[String] = []
+    if _monthly_tax_revenue_estimate() < _monthly_city_service_spending_estimate(): factors.append("The city is running a monthly operating deficit. Continued deficits add to public debt.")
+    if government.healthcare_subsidy >= 99.5: factors.append("Healthcare is free at the point of use. Residents pay almost nothing directly, but the city carries the cost.")
+    elif government.healthcare_subsidy < 30.0: factors.append("Residents pay a large share of healthcare costs, hurting low-income households and health outcomes.")
+    if government.police_budget < 75.0: factors.append("Police funding is low enough to increase response times and crime pressure.")
+    if government.education_budget > 120.0: factors.append("Education is heavily funded, improving skills and long-term productivity.")
+    if government.transit_budget < 70.0: factors.append("Public transport is underfunded, increasing congestion and reducing worker mobility.")
+    if government.housing_support_budget < 70.0 and city.avg_rent > 1200.0: factors.append("Housing support is weak while rents are high, increasing homelessness risk.")
+    if factors.is_empty(): factors.append("No city service is currently in a severe policy state. Adjust taxes and departmental budgets to shape the city.")
+    return "\n".join(factors)
