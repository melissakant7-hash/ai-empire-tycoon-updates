+func _pedestrian_next(ix: int, iy: int, tx: int, ty: int) -> Vector2i:
+    if ix == tx and iy == ty:
+        return Vector2i(ix, iy)
+    var choices: Array[Vector2i] = []
+    if ix < tx: choices.append(Vector2i(ix + 1, iy))
+    elif ix > tx: choices.append(Vector2i(ix - 1, iy))
+    if iy < ty: choices.append(Vector2i(ix, iy + 1))
+    elif iy > ty: choices.append(Vector2i(ix, iy - 1))
+    if choices.is_empty():
+        return Vector2i(ix, iy)
+    return choices[rng.randi_range(0, choices.size() - 1)]
