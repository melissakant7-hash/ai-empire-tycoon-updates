+func _seed_buildings() -> void:
+    buildings.clear()
+    for district_index in range(districts.size()):
+        var d = districts[district_index]
+        var count = int(d.density)
+        var cols = 5 if d.rect.size.x < 0.24 else 7
+        var rows = int(ceil(float(count) / float(cols)))
+        for i in range(count):
+            var col = i % cols
+            var row = int(i / cols)
+            var h1 = float((i * 47 + int(d.seed) * 13) % 100) / 100.0
+            var h2 = float((i * 31 + int(d.seed) * 29) % 100) / 100.0
+            var cell_u = 1.0 / float(cols)
+            var cell_v = 1.0 / float(max(1, rows))
+            var u = float(col) * cell_u + cell_u * (0.10 + h2 * 0.07)
+            var v = float(row) * cell_v + cell_v * (0.12 + h1 * 0.06)
+            var bw = cell_u * (0.52 + h1 * 0.18)
+            var bh = cell_v * (0.48 + h2 * 0.20)
+            buildings.append({
+                "district": district_index,
+                "u": u, "v": v, "w": bw, "h": bh,
+                "seed": h1,
+                "height": _building_height_for_district(String(d.name), h2),
+                "kind": _building_kind_for_district(String(d.name), i),
+                "occupied": 0.78 + h2 * 0.22
+            })
+
+func _building_kind_for_district(district_name: String, index: int) -> String:
+    if district_name == "Financial District" or district_name == "Tech Quarter":
+        return "office" if index % 5 != 0 else "retail"
+    if district_name == "Industrial District":
+        return "industrial"
+    if district_name == "University District":
+        return "university" if index % 3 == 0 else "residential"
+    if district_name == "Civic Center":
+        return "civic" if index % 2 == 0 else "office"
+    if district_name == "Commercial District" or district_name == "South Market" or district_name == "Riverside District":
+        return "retail" if index % 3 == 0 else ("office" if index % 3 == 1 else "residential")
+    if district_name == "Lakeside Suburbs" or district_name == "West Residential":
+        return "residential"
+    return "mixed"
+
+func _building_height_for_district(district_name: String, h: float) -> float:
+    if district_name == "Financial District":
+        return 1.45 + h * 0.85
+    if district_name == "Tech Quarter":
+        return 1.20 + h * 0.65
+    if district_name == "Industrial District" or district_name == "Lakeside Suburbs":
+        return 0.55 + h * 0.35
+    return 0.80 + h * 0.55
 
