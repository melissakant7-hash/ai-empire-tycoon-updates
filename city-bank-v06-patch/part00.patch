+func _pick_neighbor(ix: int, iy: int, prev_x: int, prev_y: int, bus: bool = false) -> Vector2i:
+    var candidates: Array[Vector2i] = []
+    if ix > 0: candidates.append(Vector2i(ix - 1, iy))
+    if ix < road_xs.size() - 1: candidates.append(Vector2i(ix + 1, iy))
+    if iy > 0: candidates.append(Vector2i(ix, iy - 1))
+    if iy < road_ys.size() - 1: candidates.append(Vector2i(ix, iy + 1))
+    if candidates.size() > 1 and prev_x >= 0:
+        for j in range(candidates.size() - 1, -1, -1):
+            if candidates[j].x == prev_x and candidates[j].y == prev_y:
+                candidates.remove_at(j)
+    if bus:
+        var main_candidates: Array[Vector2i] = []
+        for c in candidates:
+            if c.x in [1, 3, 5, 6] or c.y in [1, 2, 4, 5]:
+                main_candidates.append(c)
+        if not main_candidates.is_empty():
+            candidates = main_candidates
+    if candidates.is_empty():
+        return Vector2i(ix, iy)
+    return candidates[rng.randi_range(0, candidates.size() - 1)]
