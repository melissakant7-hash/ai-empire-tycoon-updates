+func _unhandled_key_input(event: InputEvent) -> void:
+    if not (event is InputEventKey) or not event.pressed:
+        return
+    var step = 55.0
+    if event.keycode == KEY_W: view_pan.y += step
+    elif event.keycode == KEY_S: view_pan.y -= step
+    elif event.keycode == KEY_A: view_pan.x += step
+    elif event.keycode == KEY_D: view_pan.x -= step
+    elif event.keycode == KEY_EQUAL or event.keycode == KEY_PLUS: _zoom_at(get_rect().size * 0.5, 1.12)
+    elif event.keycode == KEY_MINUS: _zoom_at(get_rect().size * 0.5, 1.0 / 1.12)
+    else: return
+    _clamp_pan()
+    queue_redraw()
