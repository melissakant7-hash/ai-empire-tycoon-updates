+func _material(color: Color, roughness: float = 0.82, metallic: float = 0.0, emission: Color = Color(0,0,0,1)) -> StandardMaterial3D:
+    var mat = StandardMaterial3D.new()
+    mat.albedo_color = color
+    mat.roughness = roughness
+    mat.metallic = metallic
+    if emission.r > 0.001 or emission.g > 0.001 or emission.b > 0.001:
+        mat.emission_enabled = true
+        mat.emission = emission
+        mat.emission_energy_multiplier = 0.35
+    return mat
+
+func _box(parent: Node, size: Vector3, position: Vector3, color: Color, name_text: String = "Box", roughness: float = 0.82, metallic: float = 0.0) -> MeshInstance3D:
+    var mesh = BoxMesh.new()
+    mesh.size = size
+    var node = MeshInstance3D.new()
+    node.name = name_text
+    node.mesh = mesh
+    node.position = position
+    node.material_override = _material(color, roughness, metallic)
+    parent.add_child(node)
+    return node
