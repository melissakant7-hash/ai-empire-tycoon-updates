+    var s = get_rect().size
+    var min_pan = s * (1.0 - view_zoom)
+    view_pan.x = clamp(view_pan.x, min_pan.x, 0.0)
+    view_pan.y = clamp(view_pan.y, min_pan.y, 0.0)
+    queue_redraw()
+
+func _screen_to_world(pos: Vector2) -> Vector2:
