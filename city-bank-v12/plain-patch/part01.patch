+    _field(x+w*0.52,y+34,"Recorded collateral value",_money(float(application.get("collateral_value",0.0))),w*0.42)
+    _field(x+12,y+82,"Outstanding loan balance",_money(float(application.get("balance",0.0))),w*0.42)
+    _field(x+w*0.52,y+82,"Delinquency","%d month(s)" % int(application.get("delinquency",0)),w*0.42)
+    _text(Vector2(x+14,y+150),"This notice advises the borrower that continued default may result in enforcement against the pledged asset, subject to the loan terms and applicable process.",10,INK)
+    y += 255
+    _text(Vector2(x,y),"No repossession or sale occurs merely because this draft exists. The notice must first be signed, marked ISSUED and sent.",10,MUTED)
