+func _ensure_loan_servicing_state(idx: int) -> void:
+    if idx < 0 or idx >= loans.size():
+        return
+    var loan = loans[idx]
+    if not loan.has("servicing_documents"):
+        loan["servicing_documents"] = []
+    if not loan.has("servicing_sequence"):
+        loan["servicing_sequence"] = 0
+    loans[idx] = loan
+
+func _loan_servicing_action_availability(loan: Dictionary, action_name: String) -> Dictionary:
+    if String(loan.get("status", "")) in ["Paid", "Written off"]:
+        return {"allowed": false, "reason": "This loan is no longer active."}
+    match action_name:
+        "payment_statement":
+            return {"allowed": true, "reason": "Create a formal account/payment statement."}
+        "payment_demand":
+            if int(loan.get("delinquency", 0)) <= 0:
+                return {"allowed": false, "reason": "A formal payment demand is only valid when a payment is overdue."}
+            return {"allowed": true, "reason": "Demand payment of current arrears."}
+        "payoff_quote":
+            return {"allowed": true, "reason": "Quote the amount required to settle the loan in full."}
+        "restructure_agreement":
+            return {"allowed": true, "reason": "Prepare revised terms. The restructure only applies after the signed and stamped agreement is sent."}
+        "acceleration_notice":
+            if int(loan.get("delinquency", 0)) < 2 and String(loan.get("status", "")) != "Defaulted":
+                return {"allowed": false, "reason": "Acceleration requires at least 60 days of delinquency or default. It makes the full outstanding balance immediately due."}
+            return {"allowed": true, "reason": "Make the full outstanding balance immediately due because of serious delinquency/default."}
