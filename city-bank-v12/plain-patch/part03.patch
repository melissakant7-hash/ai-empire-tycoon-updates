+func _prepare_loan_servicing_document(idx: int, action_name: String) -> void:
+    if idx < 0 or idx >= loans.size():
+        return
+    _ensure_loan_servicing_state(idx)
+    var loan = loans[idx]
+    var availability = _loan_servicing_action_availability(loan, action_name)
+    if not bool(availability.allowed):
+        _push_notification("Action unavailable", String(availability.reason), "warning", -1)
+        return
+    var seq = int(loan.get("servicing_sequence", 0)) + 1
+    loan["servicing_sequence"] = seq
+    var delinquency = max(0, int(loan.get("delinquency", 0)))
+    var interest_due = float(loan.balance) * float(loan.rate) / 100.0 / 12.0
+    var arrears = min(float(loan.balance) + interest_due, float(loan.monthly_payment) * float(max(1, delinquency)))
+    var payoff = float(loan.balance) + interest_due
+    var new_rate = max(0.5, float(loan.rate) - 0.65)
+    var new_term = int(loan.months_left) + 18
+    var new_payment = _monthly_payment(float(loan.balance), new_rate, new_term)
+    var doc = {
+        "id": seq,
+        "name": _loan_document_filename(action_name, loan),
+        "kind": action_name,
+        "status": "Draft",
+        "opened": false,
+        "signed": false,
+        "stamp": "",
+        "signature_points": [],
+        "sent": false,
+        "created_date": _date_string(),
+        "amount_due": float(loan.monthly_payment),
+        "arrears_amount": arrears,
+        "payoff_amount": payoff,
+        "new_rate": new_rate,
+        "new_term": new_term,
+        "new_payment": new_payment,
+        "reason": "Serious payment delinquency" if action_name == "acceleration_notice" else ("Contractual arrears" if action_name in ["payment_demand", "collateral_notice"] else "Routine loan servicing")
+    }
+    var docs: Array = loan.get("servicing_documents", [])
+    docs.append(doc)
+    loan["servicing_documents"] = docs
+    loans[idx] = loan
