+func _loan_document_filename(action_name: String, loan: Dictionary) -> String:
+    var suffix = "%04d-%02d-%02d" % [year, month, day]
+    match action_name:
+        "payment_statement": return "Loan Account Statement - %s.pdf" % suffix
+        "payment_demand": return "Formal Payment Demand - %s.pdf" % suffix
+        "payoff_quote": return "Payoff Quote - %s.pdf" % suffix
+        "restructure_agreement": return "Loan Restructure Agreement - %s.pdf" % suffix
+        "acceleration_notice": return "Notice of Acceleration - %s.pdf" % suffix
