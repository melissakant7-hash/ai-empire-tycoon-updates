+func _send_active_loan_document() -> void:
+    var li = active_loan_document_loan_index
+    var di = active_loan_document_index
+    if li < 0 or li >= loans.size():
+        return
+    var loan = loans[li]
+    var docs: Array = loan.get("servicing_documents", [])
+    if di < 0 or di >= docs.size():
+        return
+    var doc = docs[di]
+    if not bool(doc.get("opened", false)):
+        _push_notification("Send blocked", "Open and review the PDF first.", "warning", -1)
+        return
+    if not bool(doc.get("signed", false)):
+        _push_notification("Send blocked", "The bank officer signature is required.", "warning", -1)
+        return
+    if String(doc.get("stamp", "")) != "ISSUED":
+        _push_notification("Send blocked", "Stamp the document ISSUED before sending it.", "warning", -1)
+        return
+    doc["sent"] = true
+    doc["status"] = "Sent"
+    doc["sent_date"] = _date_string()
+    docs[di] = doc
+    loan["servicing_documents"] = docs
+    var action_name = String(doc.get("kind", ""))
+    match action_name:
+        "payment_statement":
+            _push_news("A formal loan account statement was sent to %s." % String(loan.borrower))
+        "payment_demand":
+            loan["collection_strategy"] = "Formal demand"
+            _push_news("A signed formal payment demand for %s was issued to %s." % [_money(float(doc.get("arrears_amount", loan.monthly_payment))), String(loan.borrower)])
+        "payoff_quote":
+            _push_news("A payoff quote of %s was issued to %s." % [_money(float(doc.get("payoff_amount", loan.balance))), String(loan.borrower)])
+        "restructure_agreement":
+            loan["rate"] = float(doc.get("new_rate", loan.rate))
+            loan["months_left"] = int(doc.get("new_term", loan.months_left))
+            loan["term"] = max(int(loan.term), int(loan.months_left))
+            loan["monthly_payment"] = float(doc.get("new_payment", loan.monthly_payment))
+            loan["pd"] = max(0.5, float(loan.pd) - 1.0)
+            loan["delinquency"] = max(0, int(loan.delinquency) - 1)
+            loan["status"] = "Restructured"
+            loan["restructured"] = true
+            bank.reputation = clamp(bank.reputation + 0.12, 0.0, 100.0)
+            _push_news("The signed restructure agreement for %s became effective." % String(loan.borrower))
+        "acceleration_notice":
+            loan["status"] = "Accelerated - full balance due"
+            loan["collection_strategy"] = "Acceleration"
+            loan["accelerated"] = true
+            loan["accelerated_amount"] = float(doc.get("payoff_amount", loan.balance))
+            bank.reputation = clamp(bank.reputation - 0.25, 0.0, 100.0)
+            _push_news("NOTICE OF ACCELERATION: %s's full outstanding balance of %s is now immediately due." % [String(loan.borrower), _money(float(loan.accelerated_amount))])
+        "collateral_notice":
+            loan["collection_strategy"] = "Collateral notice issued"
+            loan["collateral_notice_issued"] = true
+            bank.reputation = clamp(bank.reputation - 0.18, 0.0, 100.0)
+            _push_news("A signed collateral enforcement notice was sent to %s concerning %s." % [String(loan.borrower), String(loan.collateral)])
+    loans[li] = loan
+    _close_loan_document_modal(false)
+    _refresh_topbar()
+    _show_view("Current Loans")
